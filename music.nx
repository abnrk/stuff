GLOBAL SONG,RSTEP,CSTEP,TICK
SONG=5
RSTEP=12
CSTEP=3
TICK=0
SUB MUSICTICK
A=(TICK*RSTEP)
FOR C=0 TO 3
O=A+(C*CSTEP)
X$=HEX$(PEEK(ROM(SONG)+O),2)
Y$=HEX$(PEEK(ROM(SONG)+O+1),2)
Z$=HEX$(PEEK(ROM(SONG)+O+2),2)
PRINT X$,Y$,Z$
NOTE=VAL("0X"+MID$(X$,1,1))
OCTAVE=VAL("0X"+MID$(X$,2,1))
INST=VAL("0X"+MID$(Y$,1,1))
FX$=MID$(Y$,2,1)
FXDATA=VAL("0X"+Z$)
PRINT "DECODED:",NOTE,OCTAVE,INST,FX$,FXDATA
'(1*12)+1
IF (NOTE<>0) THEN
PLAY C,((OCTAVE-1)*12)+NOTE,0
END IF
NEXT C
TICK=(TICK+1) MOD (INT(SIZE(SONG)/12)+1)
END SUB
SOUND SOURCE ROM(15)
DO
CALL MUSICTICK
WAIT VBL
LOOP
#5:LAMBADA
